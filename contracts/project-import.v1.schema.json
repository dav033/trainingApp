          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "mimeType": {
                  "type": "string",
                  "enum": [
                    "image/jpeg",
                    "image/png",
                    "image/webp",
                    "image/avif"
                  ]
                },
                "byteSize": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 15728640
                }
              },
              "required": [
                "id",
                "url",
                "mimeType",
                "byteSize"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "fotoLateral": {
