    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "project": {
      "type": "object",
      "properties": {
        "externalKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "externalKey",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "nombreCompleto": {
          "type": "string",
          "maxLength": 200
        },
        "edad": {
          "type": "string",
          "maxLength": 20
        },
        "correo": {
          "type": "string",
          "maxLength": 320,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
