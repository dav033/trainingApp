{
  "name": "training-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20 <23" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @training/web",
    "dev:web": "npm run dev -w @training/web",
    "dev:api": "npm run dev -w @training/api",
    "build": "npm run build -w @training/contracts && npm run build -w @training/api && npm run build -w @training/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contracts:generate": "npm run contracts:generate -w @training/contracts",
    "contracts:check": "node scripts/check-contract-drift.mjs"
  }
}
